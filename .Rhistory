# ---- QUESTION 9 ----
set.seed(596)
n <- 38
m <- 1000
b <- 3
a0 <- 2.5
a1 <- 2.75
alpha <- 0.1
mu0 <- a0 / (a0 + b)
mu1 <- a1 / (a1 + b)
var0 <- (a0 * b) / ((a0 + b)^2 * (a0 + b + 1))
sd0 <- sqrt(var0)
z_alpha <- qnorm(1 - alpha/2)
delta <- sqrt(n) * (mu1 - mu0) / sd0
beta <- pnorm(z_alpha - delta) - pnorm(-z_alpha - delta)
nao_rejeicoes <- 0
for (i in 1:m) {
amostra <- rbeta(n, a1, b)
xbar <- mean(amostra)
z0 <- sqrt(n) * (xbar - mu0) / sd0
if (abs(z0) <= z_alpha) {
nao_rejeicoes <- nao_rejeicoes + 1
}
}
beta_hat <- nao_rejeicoes / m
resultado <- beta_hat / beta
round(resultado,4)
