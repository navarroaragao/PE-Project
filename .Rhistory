# --- Parâmetros Fixos ---
n <- 38
alpha <- 0.1
b <- 3
m <- 1000
set.seed(596)
# --- Parâmetros sob H0 (a = 2.5) ---
a0 <- 2.5
mu0 <- a0 / (a0 + b)
var0 <- (a0 * b) / ((a0 + b)^2 * (a0 + b + 1))
sd0  <- sqrt(var0)
# --- Parâmetros sob H1 (a = 2.75) ---
a1 <- 2.75
mu1 <- a1 / (a1 + b)
var1 <- (a1 * b) / ((a1 + b)^2 * (a1 + b + 1))
sd1  <- sqrt(var1)
# --- 1. Cálculo do Erro de 2.ª Espécie (Beta Teórico) ---
# Ponto Crítico para Z0 ~ N(0,1)
z_critico <- qnorm(1 - alpha)
# Cálculo de beta: P(Z0 <= z_critico | H1 é verdadeira)
# Reformulando Z0 sob H1: (X_bar - mu0) / (sd0/sqrt(n))
# Isto equivale a P(X_bar <= mu0 + z_critico * sd0/sqrt(n))
x_barra_critico <- mu0 + z_critico * (sd0 / sqrt(n))
beta_teorico <- pnorm(x_barra_critico, mean = mu1, sd = sd1 / sqrt(n))
# --- 2. Simulação (Beta Estimado) ---
# Gerar m amostras de dimensão n da Beta(2.75, 3)
amostras <- matrix(rbeta(n * m, shape1 = a1, shape2 = b), nrow = m)
medias_amostrais <- rowMeans(amostras)
# Calcular a estatística Z0 para cada uma das 1000 amostras
# Nota: usa-se mu0 e sd0 porque o teste é feito sob a validade de H0
z0_simulados <- (medias_amostrais - mu0) / (sd0 / sqrt(n))
# Beta estimado: frequência relativa de NÃO rejeições (Z0 <= z_critico)
beta_estimado <- mean(z0_simulados <= z_critico)
# --- Resultados Finais ---
quociente <- beta_estimado / beta_teorico
cat("--- Resultados ---\n")
cat("Beta Teórico (β): ", beta_teorico, "\n")
cat("Beta Estimado (β^):", beta_estimado, "\n")
cat("Quociente (β^ / β):", quociente, "\n")
# Parâmetros gerais
alpha <- 0.1
n <- 38
b <- 3
m <- 1000
# --- Parâmetros sob H0 ---
a0 <- 2.5
mu0 <- a0 / (a0 + b)
var0 <- (a0 * b) / (((a0 + b)^2) * (a0 + b + 1))
se0 <- sqrt(var0 / n)
# --- Parâmetros sob H1 ---
a1 <- 2.75
mu1 <- a1 / (a1 + b)
var1 <- (a1 * b) / (((a1 + b)^2) * (a1 + b + 1))
se1 <- sqrt(var1 / n)
# 1. Erro tipo II (beta) teórico
# Teste unilateral à direita
z_crit <- qnorm(1 - alpha)
x_crit <- mu0 + z_crit * se0
# beta = P(Não rejeitar H0 | H1 verdadeira)
beta_teo <- pnorm((x_crit - mu1) / se1)
# 2. Estimativa por simulação (beta_chap)
set.seed(596)
nao_rejeita <- 0
# Simulação de m amostras
for (i in 1:m) {
# Gera amostra da verdadeira distribuição (H1)
amostra <- rbeta(n, shape1 = a1, shape2 = b)
media_amostra <- mean(amostra)
# Calcula a estatística de teste Z0
z_obs <- (media_amostra - mu0) / se0
# Verifica se não rejeita H0
if (z_obs <= z_crit) {
nao_rejeita <- nao_rejeita + 1
}
}
beta_chap <- nao_rejeita / m
# 3. Resultado final
quociente <- beta_chap / beta_teo
cat("O valor da divisão beta_chap / beta é:", round(quociente, 4), "\n")
n <- 38          # dimensão da amostra
m <- 1000        # número de simulações
alfa <- 0.1      # nível de significância
# ── Parâmetros sob H0 ──────────────────────────────────────────
# H0: mu = mu0 = 2.5 / (2.5 + 3)
a0 <- 2.5; b0 <- 3
mu0  <- a0 / (a0 + b0)                          # média sob H0
var0 <- (a0*b0) / ((a0+b0)^2 * (a0+b0+1))      # variância populacional sob H0
se0  <- sqrt(var0 / n)                           # desvio-padrão de X̄ sob H0
# ── Região de não-rejeição ─────────────────────────────────────
# Pelo TLC, Z ~ N(0,1). Como H1: mu > mu0, o teste é unilateral à direita.
# Rejeitamos H0 se X̄ > k, onde k é o quantil (1-alfa) de N(mu0, se0²)
k <- qnorm(1 - alfa, mean = mu0, sd = se0)
# ── Parâmetros sob H1 ──────────────────────────────────────────
# H1: mu = mu1 = 2.75 / (2.75 + 3)
a1 <- 2.75; b1 <- 3
mu1  <- a1 / (a1 + b1)
var1 <- (a1*b1) / ((a1+b1)^2 * (a1+b1+1))
se1  <- sqrt(var1 / n)
# ── 1. Beta teórico ────────────────────────────────────────────
# Erro tipo II = P(não rejeitar H0 | H1 verdadeira) = P(X̄ ≤ k | mu = mu1)
beta_teo <- pnorm(k, mean = mu1, sd = se1)
# ── 2. Beta estimado por simulação ─────────────────────────────
set.seed(596)
medias   <- replicate(m, mean(rbeta(n, a1, b1)))   # m médias amostrais sob H1
beta_hat <- mean(medias <= k)                       # freq. relativa de não-rejeições
# ── Quociente final ────────────────────────────────────────────
quociente <- beta_hat / beta_teo
round(quociente, 4)
